{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage", "identity"],
  "icons": {
    "16": "assets/taskb.png",
    "32": "assets/taskb.png",
    "48": "assets/taskb48.png",
    "128": "assets/taskb.png"
  },
  "background": {
    "service_worker": "dist/background.bundle.js",
