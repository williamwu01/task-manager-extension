      "48": "assets/taskb48.png",
      "128": "assets/taskb.png"
    }
  },
  "oauth2": {
    "client_id": "483562784410-jpm3oag73cmvm9tf2avnka0p70c14bm0.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
